rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isLoggedIn() && request.auth.token.email == 'yisrael@atlow.co.il';
    }

    // Server-side circuit breaker. Because Security Rules evaluate every
    // Firestore request, flipping firestoreAccessDisabled on approvedUsers
    // stops even an already-running/stale client immediately; no app reload is
    // required. Keep the approvedUsers self-get below outside this function so
    // the UI can still explain that access is suspended.
    function isApprovedUser() {
      return isLoggedIn()
        && request.auth.token.email is string
        && exists(
          /databases/$(database)/documents/approvedUsers/$(request.auth.token.email)
        )
        && get(
          /databases/$(database)/documents/approvedUsers/$(request.auth.token.email)
        ).data.get('firestoreAccessDisabled', false) != true;
    }

    function isAdmin() {
      return isApprovedUser() &&
        get(
          /databases/$(database)/documents/approvedUsers/$(request.auth.token.email)
        ).data.isAdmin == true;
    }

    function isCellarManager() {
      return isApprovedUser() && (isAdmin() ||
        get(
          /databases/$(database)/documents/approvedUsers/$(request.auth.token.email)
        ).data.get('isCellarManager', false) == true);
    }

    match /approvedUsers/{email} {
      allow get: if isLoggedIn() && request.auth.token.email == email;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin() && email != 'yisrael@atlow.co.il';
      allow update: if isAdmin()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firestoreAccessDisabled']) || isSuperAdmin())
        && (email != 'yisrael@atlow.co.il' || request.resource.data.get('isAdmin', false) == true);
      allow update: if isLoggedIn() &&
        request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastLoggedIn', 'lastPlanningOpenedAt', 'lastPlanningTab']);
    }

    match /fermentors/{document} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    match /brews/{batchId} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
      match /measurements/{measurementId} {
        allow read: if isApprovedUser();
        allow write: if isApprovedUser();
      }
    }

    match /specs/{document} {
      allow read: if isApprovedUser();
      allow create, update: if isCellarManager() || ((document == 'brewingIngredients' || document == 'brewingRecipes') && isApprovedUser());
      allow delete: if isCellarManager();
    }

    match /styleAverages/{style} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /brewAcidHistory/{document} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    match /packagingLog/{document} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    match /calendar_events/{document} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    match /mail/{document} {
      allow write: if isAdmin();
      allow read: if false;
    }

    // A write which changes shipment selection or dispatch must advance the
    // same revision token in this Firestore transaction. App writers cannot
    // silently bypass the manual/automatic marking concurrency guard.
    function markingGuardAdvanced() {
      let guard = /databases/$(database)/documents/shipmentMarkingGuard/active;
      return existsAfter(guard)
        && getAfter(guard).data.updatedAt == request.time
        && (
          (!exists(guard) && getAfter(guard).data.revision == 1) ||
          (exists(guard) && getAfter(guard).data.revision == get(guard).data.revision + 1)
        );
    }

    function modifiesShipmentPalletMarking() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'markedForShipment', 'autoReservationWeek', 'autoReservationTruckId'
        ])
        || (request.resource.data.get('zone', '') == 'shipped'
          && resource.data.get('zone', '') != 'shipped');
    }

    match /pallets/{document} {
      allow read: if isApprovedUser();
      // New packaging pallets are unmarked by default, and can be created
      // without changing the active shipment reservation revision.
      allow create: if isApprovedUser()
        && request.resource.data.get('markedForShipment', false) == false
        && request.resource.data.get('autoReservationWeek', null) == null
        && request.resource.data.get('autoReservationTruckId', null) == null
        && request.resource.data.get('zone', '') != 'shipped';
      allow update: if isApprovedUser()
        && resource.data.get('zone', '') != 'shipped'
        && (!modifiesShipmentPalletMarking() || markingGuardAdvanced())
        && (
          resource.data.get('markedForShipment', false) != true ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'quantity','beerStyle','itemType','batchNumber','expiryDateStr'
          ])
        );
      // A marked pallet must be unmarked through the guarded workflow before
      // deletion. Shipped pallet documents are immutable traceability evidence.
      allow delete: if isApprovedUser()
        && resource.data.get('markedForShipment', false) != true
        && resource.data.get('zone', '') != 'shipped';
    }

    match /productCatalog/{document} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    match /coolerUndoHistory/{document} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    match /counters/{document} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    // The first physical shipment tied to a planned truck atomically creates
    // a permanent small claim. A second device can never issue another document
    // carrying the same planned truck identity while the planning queue is stale.
    match /shipmentTripClaims/{tripKey} {
      allow get: if isApprovedUser();
      allow list: if false;
      allow create: if isApprovedUser()
        && request.resource.data.keys().hasOnly([
          'plannedTruckId', 'dispatchDate', 'shipmentNumber', 'createdAt', 'createdBy'
        ])
        && request.resource.data.plannedTruckId is string
        && request.resource.data.plannedTruckId.size() > 0
        && request.resource.data.dispatchDate is string
        && request.resource.data.shipmentNumber is int
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /shipments/{document} {
      allow read: if isApprovedUser();
      // Physical shipments change inventory and must be written with the same
      // pallet-marking transaction. Manual invoices have NO pallet movement.
      allow create: if isApprovedUser()
        && request.resource.data.shipmentNumber is int
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.sourceType == 'manual'
            && request.resource.data.palletIds == []
            && request.resource.data.totals == [])
          ||
          (request.resource.data.sourceType == 'pallets'
            && request.resource.data.palletIds is list
            && request.resource.data.palletIds.size() > 0
            && markingGuardAdvanced())
        );
      // The document is permanent evidence: only original-copy issuance and
      // controlled reprint counters can change. Never rewrite pallet IDs,
      // manifests, customers, trip identity or dispatch timestamp after saving.
      allow update: if isApprovedUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'originalIssuedAt', 'originalIssuedBy', 'originalRestoreCount',
          'originalLastRestoredAt', 'originalLastRestoredBy'
        ]);
      allow delete: if false;
    }

    match /scheduledCellarRecommendations/{document} {
      allow read, write: if isApprovedUser();
    }

    match /ignoredCellarRecommendations/{document} {
      allow read, write: if isApprovedUser();
    }

    match /sheetSyncJobs/{requestId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        && request.resource.data.keys().hasOnly([
          'requestId', 'action', 'ownerUid', 'ownerEmail', 'state',
          'attempts', 'readingsJson', 'payloadJson', 'createdAt',
          'tankNumber', 'batchNumber', 'tankNumbers', 'operationType'
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.state == 'pending'
        && request.resource.data.attempts == 0
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('tankNumber', null) == null || request.resource.data.get('tankNumber', null) is string || request.resource.data.get('tankNumber', null) is number)
        && (request.resource.data.get('batchNumber', null) == null || request.resource.data.get('batchNumber', null) is string || request.resource.data.get('batchNumber', null) is number)
        && request.resource.data.get('operationType', '') is string
        && request.resource.data.get('operationType', '').size() <= 120
        && request.resource.data.get('tankNumbers', []) is list
        && request.resource.data.get('tankNumbers', []).size() <= 25
        && (
          (
            request.resource.data.action == 'addFermentationMeasurements'
            && request.resource.data.get('readingsJson', '') is string
            && request.resource.data.get('readingsJson', '').size() <= 50000
          )
          ||
          (
            request.resource.data.action == 'logPackagingToMasterSheet'
            && request.resource.data.get('payloadJson', '') is string
            && request.resource.data.get('payloadJson', '').size() <= 10000
          )
        );
      allow delete: if isApprovedUser()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /packagingOperations/{operationId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        && request.resource.data.operationId == operationId
        && request.resource.data.state == 'awaiting_pallets';
      allow update: if isApprovedUser()
        && request.resource.data.operationId == resource.data.operationId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['state', 'updatedAt', 'recoveryRevision', 'palletSplits', 'palletRevision', 'cleanupAfter'])
        && (
          (resource.data.state == 'awaiting_pallets'
            && request.resource.data.state in ['awaiting_pallets', 'completed'])
          || (resource.data.state == 'completed'
            && request.resource.data.state == 'completed')
        )
        && request.resource.data.get('recoveryRevision', 0) >= resource.data.get('recoveryRevision', 0)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['palletSplits'])
          || resource.data.state == 'awaiting_pallets'
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cleanupAfter'])
          || request.resource.data.state == 'completed'
        );
      allow delete: if false;
    }

    match /operationReceipts/{requestId} {
      allow get: if isApprovedUser() &&
        resource.data.userEmail == request.auth.token.email;
      allow list, create, update, delete: if false;
    }

    function isBreweryPlanner() {
      return isApprovedUser()
        && (get(/databases/$(database)/documents/approvedUsers/$(request.auth.token.email)).data.get('isAdmin', false) == true
          || get(/databases/$(database)/documents/approvedUsers/$(request.auth.token.email)).data.get('isPlannerUser', false) == true);
    }

    function validPlanningRevision() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision is int;
    }

    match /planningSettings/{settingsId} {
      allow read: if isApprovedUser();
      allow create: if isBreweryPlanner() && settingsId == 'main'
        && validPlanningRevision() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && validPlanningSettings() && atomicPlanningRevision('planningSettings', settingsId);
      allow update: if isBreweryPlanner() && settingsId == 'main'
        && validPlanningRevision() && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.get('createdAt', null)
        && validPlanningSettings() && atomicPlanningRevision('planningSettings', settingsId);
      allow delete: if false;
    }

    function validPlanningSettings() {
      return request.resource.data.keys().hasOnly(['products','targetWeeks','totalTargetWeeks','preferredRuns','lossPercent','maxWeeklyDeliveries','deliveryTransitDays','preferredDeliveryDay','stylePlanning','revision','updatedAt','updatedBy','createdAt'])
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 60
        && request.resource.data.targetWeeks is number
        && request.resource.data.targetWeeks >= 0.5 && request.resource.data.targetWeeks <= 12
        && request.resource.data.get('totalTargetWeeks', 8.5) is number
        && request.resource.data.get('totalTargetWeeks', 8.5) >= request.resource.data.targetWeeks
        && request.resource.data.get('totalTargetWeeks', 8.5) <= 26
        && request.resource.data.preferredRuns in [3,4,5]
        && request.resource.data.lossPercent is number
        && request.resource.data.lossPercent == 10
        && request.resource.data.get('preferredDeliveryDay', 0) in [0,1]
        && request.resource.data.get('maxWeeklyDeliveries', 2) in [1,2]
        && request.resource.data.get('deliveryTransitDays', 0) is int
        && request.resource.data.get('deliveryTransitDays', 0) == 0
        && request.resource.data.get('stylePlanning', {}) is map;
    }

    // Serialize decisions which mark or auto-reserve physical pallets.
    // This single revision record is updated in the same transaction as the
    // pallet mutations, so concurrent clients cannot both commit from a
    // snapshot that predates another device's reservation.
    match /shipmentMarkingGuard/{guardId} {
      allow get: if isApprovedUser() && guardId == 'active';
      allow list: if false;
      allow create: if isApprovedUser() && guardId == 'active'
        && request.resource.data.keys().hasOnly(['revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isApprovedUser() && guardId == 'active'
        && request.resource.data.keys().hasOnly(['revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /shipmentPlanningQueue/{weekId} {
      allow read: if isApprovedUser();
      allow create, update: if isBreweryPlanner()
        && request.resource.data.keys().hasOnly([
          'id', 'revision', 'projectionVersion', 'deliveries', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == weekId
        && weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.projectionVersion == 1
        && request.resource.data.deliveries is list
        && request.resource.data.deliveries.size() <= 60
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /planningWeeks/{weekId} {
      allow read: if isApprovedUser();
      allow create: if isBreweryPlanner() && validPlanningRevision()
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && validPlanningWeek(weekId) && atomicPlanningRevision('planningWeeks', weekId);
      allow update: if isBreweryPlanner() && validPlanningRevision()
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.get('createdAt', null) && validPlanningWeek(weekId) && atomicPlanningRevision('planningWeeks', weekId);
      allow delete: if false;
    }

    function validPlanningWeek(weekId) {
      return request.resource.data.keys().hasOnly(['id','packaging','brews','note','maxRuns','deliveries','deliveryDates','dismissedRecommendations','allowExceptions','oversizeTruckApprovals','changeReason','calendarEvents','calendarNotes','recommendationEvidence','revision','updatedAt','updatedBy','createdAt'])
        && request.resource.data.id == weekId
        && weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.packaging is list
        && (request.resource.data.packaging.size() <= 60 || request.resource.data.packaging == resource.data.get('packaging', []))
        && request.resource.data.brews is list
        && (request.resource.data.brews.size() <= 30 || request.resource.data.brews == resource.data.get('brews', []))
        && request.resource.data.note is string && request.resource.data.note.size() <= 5000
        && request.resource.data.maxRuns in [0,1,2,3,4,5]
        && request.resource.data.get('deliveries', []) is list
        && (request.resource.data.get('deliveries', []).size() <= 60 || request.resource.data.get('deliveries', []) == resource.data.get('deliveries', []))
        && request.resource.data.get('deliveryDates', []) is list
        && (request.resource.data.get('deliveryDates', []).size() <= 14 || request.resource.data.get('deliveryDates', []) == resource.data.get('deliveryDates', []))
        && request.resource.data.get('dismissedRecommendations', []) is list
        && (request.resource.data.get('dismissedRecommendations', []).size() <= 300 || request.resource.data.get('dismissedRecommendations', []) == resource.data.get('dismissedRecommendations', []))
        && request.resource.data.get('allowExceptions', false) is bool
        && request.resource.data.get('oversizeTruckApprovals', []) is list
        && request.resource.data.get('oversizeTruckApprovals', []).size() <= 30
        && request.resource.data.get('changeReason', '') is string
        && request.resource.data.get('changeReason', '').size() <= 200
        && request.resource.data.get('calendarEvents', []) is list
        && (request.resource.data.get('calendarEvents', []).size() <= 100 || request.resource.data.get('calendarEvents', []) == resource.data.get('calendarEvents', []))
        && request.resource.data.get('calendarNotes', {}) is map
        && request.resource.data.get('recommendationEvidence', []) is list
        && request.resource.data.get('recommendationEvidence', []).size() <= 120;
    }

    function atomicPlanningRevision(collectionName, documentId) {
      let revision = string(request.resource.data.revision);
      return getAfter(/databases/$(database)/documents/$(collectionName)/$(documentId)/revisions/$(revision)).data == request.resource.data;
    }

    match /planningWeeks/{weekId}/revisions/{revisionId} {
      allow read: if isApprovedUser();
      allow create: if isBreweryPlanner()
        && revisionId == string(request.resource.data.revision)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/planningWeeks/$(weekId)).data == request.resource.data;
      allow update, delete: if false;
    }

    match /planningSettings/{settingsId}/revisions/{revisionId} {
      allow read: if isApprovedUser();
      allow create: if isBreweryPlanner()
        && revisionId == string(request.resource.data.revision)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/planningSettings/$(settingsId)).data == request.resource.data;
      allow update, delete: if false;
    }

    match /brewSheetCreationJobs/{batchId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow update: if false;
      allow delete: if isApprovedUser();
    }

    match /pendingBrews/{batchId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser()
        && request.resource.data.keys().hasOnly([
          'batchNumber', 'beerStyle', 'tankNumber', 'tankType',
          'fileId', 'fileName', 'sheetUrl', 'createdAt'
        ])
        && request.resource.data.batchNumber == batchId
        && batchId.matches('^[0-9]+$')
        && request.resource.data.beerStyle is string
        && request.resource.data.tankNumber is string
        && request.resource.data.fileId is string
        && request.resource.data.sheetUrl is string;
      allow delete: if isApprovedUser();
    }

    match /brewPlanningQueue/{weekId} {
      allow read: if isApprovedUser();
      allow create, update: if isBreweryPlanner()
        && request.resource.data.keys().hasOnly([
          'id', 'revision', 'brews', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == weekId
        && weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.brews is list
        && request.resource.data.brews.size() <= 30
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /planningSnapshots/{snapshotId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }
  }
}
