{
  "name": "fermenter-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:planning": "node scripts/test-planning.mjs",
    "test:dashboard": "node scripts/test-dashboard.mjs",
    "test:planning-snapshots": "node scripts/test-planning-snapshots.mjs",
    "test:cellar-action-kpis": "node scripts/test-cellar-action-kpis.mjs",
    "test": "npm run test:yesterday-actions && npm run test:cellar-action-kpis && npm run test:salinity && npm run test:hydrometer && npm run test:hop-volume && npm run test:packaging-print-text && npm run test:planning && npm run test:dashboard && npm run test:planning-snapshots && npm run test:server-regressions && npm run test:packaging-pallets && npm run test:shipment-traceability && npm run test:batch-traceability",
    "test:server-regressions": "node scripts/test-server-regressions.mjs",
    "test:packaging-pallets": "node scripts/test-packaging-pallet-defaults.mjs",
    "test:shipment-traceability": "node --test scripts/test-shipment-traceability.mjs",
    "test:yesterday-actions": "node scripts/test-yesterday-action-notes.mjs",
    "test:salinity": "node scripts/test-salinity-correction.mjs",
    "test:hydrometer": "node scripts/test-hydrometer-target.mjs",
    "test:hop-volume": "node scripts/test-hop-volume-recalculation.mjs",
    "test:packaging-print-text": "node scripts/test-packaging-print-text.mjs",
    "test:batch-traceability": "node --test scripts/test-batch-traceability.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
